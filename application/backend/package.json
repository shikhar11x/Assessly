{
  "name": "assessly-backend",
  "version": "1.0.0",
  "description": "Assessly REST API",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest --runInBand --testPathIgnorePatterns integration",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test:integration": "jest --runInBand --testPathPatterns integration",
    "test:ci": "jest --runInBand --testPathIgnorePatterns integration --reporters=default --reporters=jest-junit",
    "test:integration:ci": "jest --runInBand --testPathPatterns integration --reporters=default --reporters=jest-junit",
    "seed:admin": "node src/seed_admin.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup.js"
    ]
  }
}
